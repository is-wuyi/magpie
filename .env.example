# Copy to .env and replace every required value. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# At least 32 random bytes each; use independent values.
MAGPIE_AUTH_SECRET=replace-with-at-least-32-random-bytes
# base64 of exactly 32 random bytes (openssl rand -base64 32).
MAGPIE_CONFIG_KEY=replace-with-base64-encoded-32-byte-key
MAGPIE_ADMIN_EMAILS=admin@example.com
MAGPIE_PUBLIC_URL=https://relay.example.com
MAGPIE_AUTH_TRUST_PROXY_HEADERS=true
# Set true only when house upstreams intentionally live in a private VPC.
MAGPIE_ALLOW_PRIVATE_UPSTREAMS=false

MAGPIE_SMTP_HOST=smtp.example.com
MAGPIE_SMTP_PORT=587
MAGPIE_SMTP_USERNAME=
MAGPIE_SMTP_PASSWORD=
MAGPIE_SMTP_FROM=magpie <noreply@example.com>
MAGPIE_SMTP_FROM_NAME=magpie
MAGPIE_SMTP_TLS=starttls

# Comma-separated CNY amounts; the server, not the browser, owns the prices.
MAGPIE_RECHARGE_PRESETS=10,20,50,100,200,500

# Optional Alipay page-pay configuration. PEM values may use \n escapes.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# Optional WeChat Pay API v3 Native configuration.
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_MERCHANT_SERIAL=
WECHAT_PRIVATE_KEY=
WECHAT_API_V3_KEY=
# Separate multiple PEM certificates with a blank line.
WECHAT_PLATFORM_CERTIFICATES=
